{
  "name": "storybook-brands-addon",
  "version": "0.2.0",
  "description": "Switch between consumer-defined brands in Storybook",
  "keywords": [
    "storybook-addon",
    "storybook",
    "brands",
    "design-system",
    "theming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/roncallyt/storybook-brands-addon.git"
  },
  "homepage": "https://github.com/roncallyt/storybook-brands-addon#readme",
  "bugs": {
    "url": "https://github.com/roncallyt/storybook-brands-addon/issues"
  },
  "license": "MIT",
  "author": "Thomerson Roncally Araújo Teixeira <thomersonroncally@outlook.com>",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "README.md",
    "manager.js",
    "preset.js",
    "preview.js"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "prepack": "pnpm build",
    "build": "tsup",
    "build-storybook": "storybook build",
    "build:watch": "pnpm build --watch",
    "changelog": "changelogen --noAuthors",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "release:prepare": "changelogen --release --noAuthors --no-github",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:browser": "node scripts/test-storybook-compatibility.mjs",
    "test:browser:playwright": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/icons": "^2.1.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^20",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.7.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "storybook": "^9.0.0 || ^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Brand Switcher"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
